rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // -----------------------------------------------------------------
    // Account profile and characters:  tsm_players/{uid}/...
    // -----------------------------------------------------------------
    match /tsm_players/{uid} {

      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['schema_version', 'email', 'created_at'])
        && request.resource.data.schema_version == 1
        && request.resource.data.email is string
        && request.resource.data.created_at is string;

      allow update, delete: if false;

      match /characters/{slotId} {

        // A brand-new character: fixed starting values, valid name and class,
        // and it must be created together with its name reservation.
        function validNewCharacter() {
          let d = request.resource.data;
          let nameDoc = /databases/$(database)/documents/tsm_names/$(d.name.lower());
          return d.keys().hasOnly([
              'schema_version', 'name', 'class_id', 'appearance', 'level', 'exp',
              'rebirth', 'stat_points', 'gold', 'current_map', 'inventory',
              'equipment', 'created_at', 'updated_at'])
            && d.keys().hasAll([
              'schema_version', 'name', 'class_id', 'appearance', 'level', 'exp',
              'rebirth', 'stat_points', 'gold', 'current_map', 'inventory',
              'equipment', 'created_at', 'updated_at'])
            && slotId in ['slot_1', 'slot_2', 'slot_3', 'slot_4']
            && d.schema_version == 1
            && d.name is string
            && d.name.matches('^[A-Za-z0-9_]{3,16}$')
            && d.class_id in ['warrior', 'mage', 'archer', 'rogue', 'gunner',
                              'extreme', 'brawler', 'healer', 'necromancer']
            && d.level == 1
            && d.exp == 0
            && d.rebirth == 0
            && d.stat_points == 0
            && d.gold == 0
            && d.current_map == 'map_1'
            && d.appearance is map
            && d.inventory is list
            && d.inventory.size() == 0
            && d.equipment is map
            && d.created_at is string
            && d.updated_at is string
            && existsAfter(nameDoc)
            && getAfter(nameDoc).data.uid == request.auth.uid
            && getAfter(nameDoc).data.slot == slotId;
        }

        // Attribute points: the 8 known attributes only, whole numbers, and the
        // points spent plus the points still unspent can never be more than the
        // character has earned. 5 points per level; each rebirth completes 299
        // levels. (Keep these numbers in step with TSM_Progression.json.)
        function validAttributes(a, points, level, rebirth) {
          return a.keys().hasOnly(['str', 'int', 'vit', 'dex', 'wis', 'lck', 'agi', 'cha'])
            && a.keys().hasAll(['str', 'int', 'vit', 'dex', 'wis', 'lck', 'agi', 'cha'])
            && a['str'] is int && a['str'] >= 0 && a['str'] <= 999
            && a['int'] is int && a['int'] >= 0 && a['int'] <= 999
            && a['vit'] is int && a['vit'] >= 0 && a['vit'] <= 999
            && a['dex'] is int && a['dex'] >= 0 && a['dex'] <= 999
            && a['wis'] is int && a['wis'] >= 0 && a['wis'] <= 999
            && a['lck'] is int && a['lck'] >= 0 && a['lck'] <= 999
            && a['agi'] is int && a['agi'] >= 0 && a['agi'] <= 999
            && a['cha'] is int && a['cha'] >= 0 && a['cha'] <= 999
            && (a['str'] + a['int'] + a['vit'] + a['dex'] + a['wis'] + a['lck'] + a['agi'] + a['cha'] + points)
                <= 5 * (level - 1 + 299 * rebirth);
        }

        // Potion settings: Auto Pot switches and limits (5 to 95 percent) and the
        // three quick-use slots (just item names).
        function validSettings(s) {
          return s.keys().hasOnly(['auto_hp', 'auto_mp', 'hp_percent', 'mp_percent', 'quick_slots'])
            && s.keys().hasAll(['auto_hp', 'auto_mp', 'hp_percent', 'mp_percent', 'quick_slots'])
            && s.auto_hp is bool
            && s.auto_mp is bool
            && s.hp_percent is int && s.hp_percent >= 5 && s.hp_percent <= 95
            && s.mp_percent is int && s.mp_percent >= 5 && s.mp_percent <= 95
            && s.quick_slots is map
            && s.quick_slots.keys().hasOnly(['health', 'mana', 'stamina'])
            && s.quick_slots.keys().hasAll(['health', 'mana', 'stamina'])
            && s.quick_slots.health is string && s.quick_slots.health.size() <= 40
            && s.quick_slots.mana is string && s.quick_slots.mana.size() <= 40
            && s.quick_slots.stamina is string && s.quick_slots.stamina.size() <= 40;
        }

        // Skills: what is learned (skill id -> rank), the eight slots, ultimate and
        // special attack ranks, and the trials. Points are worked out from the level.
        function validSkills(k) {
          return k.keys().hasOnly(['learned', 'slots', 'abilities', 'trials'])
            && k.keys().hasAll(['learned', 'slots'])
            && k.learned is map && k.learned.size() <= 40
            && k.slots is map && k.slots.size() <= 12
            && (!('abilities' in k) || (k.abilities is map && k.abilities.size() <= 4))
            && (!('trials' in k) || (k.trials is map && k.trials.size() <= 4));
        }

        // Saved health, mana and stamina.
        function validVitals(v) {
          return v.keys().hasOnly(['hp', 'mp', 'sp'])
            && v.keys().hasAll(['hp', 'mp', 'sp'])
            && v.hp is number && v.hp >= 0 && v.hp <= 100000000
            && v.mp is number && v.mp >= 0 && v.mp <= 100000000
            && v.sp is number && v.sp >= 0 && v.sp <= 100000000;
        }

        // The active elixir: empty, or an id with start and end times. It can run
        // at most 30 days, and cannot end further ahead than that from now.
        function validElixir(e) {
          return e.size() == 0 || (
            e.keys().hasOnly(['id', 'activated_at', 'expires_at'])
            && e.keys().hasAll(['id', 'activated_at', 'expires_at'])
            && e.id is string && e.id.size() <= 40
            && e.activated_at is int && e.expires_at is int
            && e.expires_at > e.activated_at
            && e.expires_at - e.activated_at <= 30 * 86400
            && e.expires_at <= request.time.toMillis() / 1000.0 + 30 * 86400 + 600);
        }

        // Saving progress: name, class and creation date can never change,
        // and values must stay inside the game's limits.
        function validUpdate() {
          let before = resource.data;
          let after = request.resource.data;
          return after.diff(before).affectedKeys().hasOnly([
              'level', 'exp', 'rebirth', 'stat_points', 'gold', 'current_map',
              'inventory', 'equipment', 'appearance', 'attributes', 'settings',
              'vitals', 'elixir', 'waypoints', 'skills', 'updated_at'])
            && after.level is int && after.level >= 1 && after.level <= 300
            && after.rebirth is int && after.rebirth >= before.rebirth && after.rebirth <= 10
            && after.exp is number && after.exp >= 0
            && after.stat_points is int && after.stat_points >= 0
            && after.stat_points <= 5 * (after.level - 1 + 299 * after.rebirth)
            && after.gold is number && after.gold >= 0
            && after.updated_at is string
            && after.inventory is list && after.inventory.size() <= 100
            && after.equipment is map
            && after.equipment.keys().hasOnly([
                'weapon', 'armor', 'helmet', 'gloves', 'pants', 'boots',
                'ring_1', 'ring_2', 'accessory', 'pet', 'mount'])
            && (!('attributes' in after)
                || validAttributes(after['attributes'], after.stat_points, after.level, after.rebirth))
            && (!('settings' in after) || validSettings(after['settings']))
            && (!('vitals' in after) || validVitals(after['vitals']))
            && (!('elixir' in after) || validElixir(after['elixir']))
            && (!('waypoints' in after)
                || (after['waypoints'] is list && after['waypoints'].size() <= 100))
            && (!('skills' in after) || validSkills(after['skills']));
        }

        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validNewCharacter();
        allow update: if isOwner(uid) && validUpdate();
        allow delete: if false;
      }
    }

    // -----------------------------------------------------------------
    // Character-name reservations:  tsm_names/{lowercase name}
    // Nobody can read or list these (no name browsing). A reservation can
    // only be created together with the character that owns the name.
    // -----------------------------------------------------------------
    match /tsm_names/{nameKey} {
      allow create: if signedIn()
        && nameKey.matches('^[a-z0-9_]{3,16}$')
        && request.resource.data.keys().hasOnly(['uid', 'name', 'slot', 'created_at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.lower() == nameKey
        && request.resource.data.slot in ['slot_1', 'slot_2', 'slot_3', 'slot_4']
        && getAfter(/databases/$(database)/documents/tsm_players/$(request.auth.uid)/characters/$(request.resource.data.slot)).data.name == request.resource.data.name;
      allow read, update, delete: if false;
    }
  }
}
